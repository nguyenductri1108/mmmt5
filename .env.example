# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in.  NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Telegram -------------------------------------------------------------
# 1. Talk to @BotFather on Telegram -> /newbot -> copy the token here.
# 2. Send any message to your new bot, then run:  python run.py chatid
#    and paste the number it prints into TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# --- MetaTrader 5 (Windows only) -----------------------------------------
# Leave MT5_PATH empty to let the library auto-detect the running terminal.
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
MT5_SERVER=YourBroker-Demo
MT5_PATH=

# --- AI providers ---------------------------------------------------------
# Both are optional. If neither is set, the AI gate is skipped entirely
# (set ai.enabled=false in config.yaml to silence the warning).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
